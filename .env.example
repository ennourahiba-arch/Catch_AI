# Never put secret keys in the frontend or in any variable starting with VITE_
# (those are shipped to every browser).

# --- Frontend (set in Vercel: Settings -> Environment Variables) ---
# URL of the classroom server on Render. No trailing slash.
VITE_API_URL=https://catch-ai-api.onrender.com

# --- Backend (set in Render: Environment) ---
# Your Vercel site address. Comma-separate several. "*" allows any site.
ALLOWED_ORIGINS=https://your-project.vercel.app
# Optional: where SQLite stores temporary rooms, and how long rooms live.
# DB_PATH=catchai.db
# ROOM_TTL_MINUTES=180

# --- Phase 4 (backend only, not used yet) ---
# EXAMINER_API_KEY=
# OLLAMA_URL=http://localhost:11434
