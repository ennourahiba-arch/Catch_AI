# Phase 1 needs NO environment variables. The app runs fully without any keys.
# These are placeholders for later phases. Never put secret keys in frontend code
# or in any variable starting with VITE_ (those are shipped to the browser).

# Phase 2: URL of the classroom API server (FastAPI), used by the frontend.
# VITE_API_URL=https://your-backend.example.com

# Phase 4 (server-side only): hosted LLM for the Examiner agent.
# EXAMINER_API_KEY=
# OLLAMA_URL=http://localhost:11434
