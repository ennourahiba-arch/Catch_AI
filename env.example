# Never put secret keys in the frontend or in any variable starting with VITE_
# (those are shipped to every browser).

# --- Frontend (set in Vercel: Settings -> Environment Variables) ---
# URL of the classroom server on Render. No trailing slash.
VITE_API_URL=https://catch-ai-api.onrender.com

# --- Backend (set in Render: Environment) ---
# Your Vercel site address. Comma-separate several. "*" allows any site.
ALLOWED_ORIGINS=https://your-project.vercel.app
# Optional: where SQLite stores temporary rooms, and how long rooms live.
# DB_PATH=catchai.db
# ROOM_TTL_MINUTES=180

# --- AI features for any subject (backend only, set in Render) ---
# gemini | anthropic | fake   (fake = simulated AI for testing, clearly labelled in the app)
LLM_PROVIDER=gemini
# From https://aistudio.google.com (free tier available). Never commit a real key.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional: override the model if the default is retired, e.g. a current name from AI Studio.
# LLM_MODEL=gemini-2.5-flash
# Optional: require a code before anyone can use AI features (share it with your class).
# ACCESS_CODE=
# Optional limits per visitor per hour (defaults 6 and 120).
# AI_GENERATIONS_PER_HOUR=6
# AI_MESSAGES_PER_HOUR=120
